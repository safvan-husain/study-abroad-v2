AGENT_SERVER_URL=http://localhost:2024
SMOKE_TEST_GRAPH_ID=agent

API_PORT=3001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=study_abroad
SPACETIME_URL=http://localhost:3000
SPACETIME_DATABASE=study-abroad-coordinator
