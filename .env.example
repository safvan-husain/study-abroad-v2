AGENT_SERVER_URL=http://localhost:2025
SMOKE_TEST_GRAPH_ID=agent

API_PORT=3101
WEB_PORT=3100
SPACETIME_URL=http://localhost:3002
SPACETIME_DATABASE=study-abroad-coordinator
NEXT_PUBLIC_SPACETIME_URL=ws://localhost:3002
NEXT_PUBLIC_SPACETIME_DATABASE=study-abroad-coordinator
# Seeded local service account used by the AI worker.
AGENT_USERNAME=study_abroad_agent
AGENT_PASSWORD=study-agent-dev
USE_LIVE_COORDINATOR=true
WORKER_ID=local-worker
WORKER_LEASE_SECONDS=60
AGENT_GRAPH_ID=agent
# Set true only when the smoke command should publish the local module first.
SPACETIME_PUBLISH=false

# Optional Ollama for Agent Server discovery and course-fit prose.
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=<your-api-key>
export LANGSMITH_PROJECT="study-abroad-v2-agents"
