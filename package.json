{
  "name": "study-abroad-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Study Abroad architecture spike and application workspace",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "agent:dev": "pnpm --filter @study-abroad/agent-server agent:dev",
    "agent:clone-thread": "tsx scripts/clone-langsmith-thread.ts",
    "agent:smoke": "tsx scripts/agent-observability.ts",
    "agent:trace:smoke": "LANGSMITH_TRACING=true tsx scripts/agent-observability.ts",
    "agent:chat:smoke": "tsx scripts/agent-chat-smoke.ts",
    "agent:python:test": "uv --directory services/agent-server run --extra test pytest",
    "trace:clone:test": "vitest run test/clone-langsmith-thread.test.ts",
    "agent:test": "pnpm --filter @study-abroad/agent-server test",
    "typecheck": "pnpm --filter @study-abroad/agent-graph typecheck",
    "test": "pnpm agent:test"
  },
  "devDependencies": {
    "@langchain/langgraph-sdk": "^1.9.28",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "langsmith": "^0.8.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
